#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PHP_BIN="${PHP_BIN:-php}"
EXTENSION="${KING_EXTENSION:-$ROOT/extension/modules/king.so}"
SCRIPT="$ROOT/infra/inference/king-local-infer.php"

if [[ ! -f "$EXTENSION" ]]; then
  echo "king-local-infer: King extension module not found at $EXTENSION" >&2
  exit 127
fi

exec "$PHP_BIN" -n \
  -d "extension=$EXTENSION" \
  -d king.security_allow_config_override=1 \
  "$SCRIPT" "$@"
